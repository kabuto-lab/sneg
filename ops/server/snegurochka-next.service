[Unit]
Description=Snegurochki Moscow Next.js (snegurochkimoscow.com)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sneg/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/sneg/current/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 5134
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
